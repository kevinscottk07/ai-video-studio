{
  "name": "ai-video-studio-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "tsx src/scripts/migrate.ts migrate",
    "db:migrate:create": "tsx src/scripts/migrate.ts create",
    "db:migrate:reset": "tsx src/scripts/migrate.ts reset",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:uat": "tsx src/scripts/seedUATData.ts",
    "db:seed:moderation": "tsx src/scripts/seedModerationData.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:test": "tsx src/scripts/testPrismaSetup.ts"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.0",
    "@supabase/supabase-js": "^2.38.0",
    "@prisma/client": "^5.6.0",
    "prisma": "^5.6.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.1.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.0",
    "aws-sdk": "^2.1490.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/client-bedrock-runtime": "^3.450.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "axios": "^1.6.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.0",
    "express-async-errors": "^3.1.1",
    "node-cron": "^3.0.0",
    "uuid": "^9.0.0",
    "sharp": "^0.32.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/multer": "^1.4.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jwks-rsa": "^3.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.9.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/pg": "^8.10.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "typescript": "^5.2.0",
    "tsx": "^4.1.0",
    "vitest": "^0.34.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.16",
    "fast-check": "^3.15.0"
  }
}