{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "env": {
    "VITE_DEMO_MODE": "true",
    "VITE_AUTH0_DOMAIN": "dev-ai-video-studio.us.auth0.com",
    "VITE_AUTH0_CLIENT_ID": "demo-client-id",
    "VITE_AUTH0_AUDIENCE": "https://api.aivideostudio.com",
    "VITE_APP_NAME": "AI Video Studio",
    "VITE_APP_VERSION": "1.0.0"
  },
  "headers": [
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/assets/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!js|assets|images|fonts|favicon\\.ico|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
