# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ai_video_studio?schema=public"

# For local development with Supabase
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Server Configuration
NODE_ENV="development"
PORT=3001
HOST="localhost"
APP_VERSION="1.0.0"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="ai-video-studio-assets"

# AWS Bedrock Configuration
BEDROCK_TEXT_MODEL="anthropic.claude-3-sonnet-20240229-v1:0"
BEDROCK_IMAGE_MODEL="stability.stable-diffusion-xl-v1"
BEDROCK_VIDEO_MODEL="stability.stable-video-diffusion-img2vid-v1"
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7
BEDROCK_TIMEOUT=60000

# AWS Cost Tracking
ENABLE_COST_TRACKING=true
BEDROCK_INPUT_TOKEN_COST=0.00125
BEDROCK_OUTPUT_TOKEN_COST=0.00375
PLATFORM_PROFIT_MARGIN=2.0

# Auth0 Configuration
AUTH0_DOMAIN="your-auth0-domain.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_AUDIENCE="your-auth0-api-audience"

# LemonSqueezy Configuration
LEMONSQUEEZY_API_KEY="your-lemonsqueezy-api-key"
LEMONSQUEEZY_WEBHOOK_SECRET="your-lemonsqueezy-webhook-secret"

# Email Configuration
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="noreply@aivideostudio.com"

# Logging
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE_MB=500
MAX_FILES_PER_PROJECT=50

# Credit System
CREDIT_PRICE_CENTS=5
DEFAULT_FREE_CREDITS=10